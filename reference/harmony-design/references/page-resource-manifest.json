{
  "schema": "standalone-page-generation/resource-manifest-v1",
  "tokenSource": "src/styles/global.css",
  "iconSource": "src/components/HMSymbolIcon/hmsymbol-icon.generated.ts",
  "sharedTokens": [
    "--harmony-brand",
    "--harmony-video-brand",
    "--harmony-warning",
    "--harmony-font-primary",
    "--harmony-font-secondary",
    "--harmony-font-tertiary",
    "--harmony-font-on-primary",
    "--harmony-font-on-secondary",
    "--harmony-icon-primary",
    "--harmony-icon-emphasize",
    "--harmony-background-primary",
    "--harmony-background-secondary",
    "--harmony-comp-background-primary",
    "--harmony-comp-background-gray",
    "--harmony-comp-background-secondary",
    "--harmony-comp-background-emphasize",
    "--harmony-comp-divider"
