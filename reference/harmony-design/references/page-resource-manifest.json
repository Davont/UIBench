    "mobile-settings": {
      "templateId": "settings-page",
      "componentIds": [
        "hmsymbol-icon",
        "list-container"
      ],
      "commonIcons": [
        "chevron_right",
        "gearshape"
      ],
      "patterns": []
    },
    "page-shell": {
      "templateId": "mobile-phone-shell-template",
      "componentIds": [
        "hmsymbol-icon",
        "list-container",
        "grid-container",
        "floating-tab"
      ],
      "commonIcons": [
        "house_fill",
        "chevron_left",
        "chevron_right",
        "person_crop_circle_fill_1"
      ],
      "patterns": []
