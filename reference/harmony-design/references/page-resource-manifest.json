  "pageTypes": {
    "mobile-card": {
      "templateId": "mobile-card-template",
      "componentIds": [
        "hmsymbol-icon",
        "list-container",
        "grid-container",
        "search",
        "floating-tab"
      ],
      "commonIcons": [
        "house_fill",
        "magnifyingglass",
        "chevron_down",
        "checkmark",
        "checkmark_circle_fill",
        "star_fill",
        "calendar_fill",
        "gearshape",
        "message",
        "doc_text",
        "person_crop_circle_fill_1",
        "book_open_fill",
        "drop",
        "figure_running"
      ],
      "patterns": [
        {
          "id": "mobile-metric-dashboard",
          "triggers": [
            "指标卡",
            "连续天数",
            "打卡",
            "周进度",
            "习惯列表",
            "KPI"
          ],
          "source": "skills/03-prototype-generation/standalone-page-generation/references/patterns/mobile-metric-dashboard.md"
        }
      ]
    },
    "mobile-grid": {
      "templateId": "mobile-grid-template",
      "componentIds": [
        "hmsymbol-icon",
        "grid-container",
        "list-container",
        "search",
        "floating-tab"
      ],
      "commonIcons": [
        "house_fill",
        "magnifyingglass",
        "chevron_down",
        "person_crop_circle_fill_1"
